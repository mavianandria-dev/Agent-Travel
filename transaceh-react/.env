# local (default) atau sheets
# Tetap local sampai Web App 1.2.0 ter-deploy, CORS lulus, dan uji per peran selesai.
VITE_DATA_MODE=local

# URL Web App Apps Script yang berakhiran /exec.
# Kosongkan sampai deployment 1.2.0 terverifikasi. Hanya dipakai bila
# VITE_DATA_MODE=sheets.
VITE_SHEETS_URL=

# URL dasar Cloudflare Worker (tanpa /api/chat).
# Kosongkan untuk memakai chatbot FAQ lokal.
VITE_AI_PROXY_URL=
